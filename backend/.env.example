# FastAPI process only. Do not copy these values to web/.env.local or browser code.
FOCUSOS_SUPABASE_URL=https://your-project.supabase.co
FOCUSOS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
FOCUSOS_SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me

# JSON object containing versioned Base64-encoded 32-byte AES keys.
FOCUSOS_TOKEN_ENCRYPTION_KEYS={"1":"replace-with-base64-32-byte-key"}
FOCUSOS_TOKEN_ENCRYPTION_ACTIVE_VERSION=1

FOCUSOS_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
FOCUSOS_GOOGLE_CLIENT_SECRET=your-google-web-client-secret
FOCUSOS_GOOGLE_REDIRECT_URIS=http://localhost:3000/api/integrations/google/callback,https://focusos-web-five.vercel.app/api/integrations/google/callback
