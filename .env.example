# Copy the web values into web/.env.local for local development.
# The publishable key is safe for the browser; never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
FOCUSOS_APP_URL=http://localhost:3000
# Server-only Next.js route target.
FOCUSOS_API_URL=http://127.0.0.1:8000

# Set these in the FastAPI process environment (see README).
# They must point to the same Supabase project as the web values.
FOCUSOS_SUPABASE_URL=https://your-project.supabase.co
FOCUSOS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Google OAuth integration: the ID may be shared with the Supabase Google provider.
# The state secret is a distinct 32-byte Base64 key used only by Next.js server routes.
FOCUSOS_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
FOCUSOS_GOOGLE_STATE_SECRET=generate-a-distinct-32-byte-base64-key
