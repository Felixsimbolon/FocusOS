# Copy these values into web/.env.local for local development.
# The Supabase URL and publishable key are designed to be public.
# FOCUSOS_APP_URL is the origin of the Next.js web app.
# Never put real secrets or a service-role key in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
FOCUSOS_APP_URL=http://localhost:3000
